---
/**
 * Fila de la lista editorial de la portada: número, nombre grande, ingredientes
 * y precio. Al pasar el ratón la fila se rellena del color de acento del plato
 * (de abajo arriba) y el texto pasa a negro.
 */
import { formatPrice, type MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
  index: number;
}

const { item, index } = Astro.props;

// Mapa de clases completas: Tailwind solo genera clases que ve escritas
const fill = { mustard: 'bg-mustard', ketchup: 'bg-ketchup', pickle: 'bg-pickle' }[item.accent];
---

<article class="group relative isolate overflow-hidden border-b border-line">
  <!-- Relleno de color al pasar el ratón: solo en pantallas con puntero fino -->
  <span
    class:list={['absolute inset-0 -z-10 origin-bottom scale-y-0 transition-transform duration-300 ease-out pointer-fine:group-hover:scale-y-100', fill]}
    aria-hidden="true"
  ></span>

  <div class="grid gap-x-8 gap-y-3 py-7 transition-colors duration-300 pointer-fine:group-hover:text-ink sm:px-4 md:grid-cols-[3rem_1fr_minmax(0,22rem)_auto] md:items-baseline">
    <span class="font-mono text-sm text-muted transition-colors pointer-fine:group-hover:text-ink/60" aria-hidden="true">
      {String(index).padStart(2, '0')}
    </span>

    <div>
      <h3 class="text-3xl leading-none sm:text-5xl">{item.name}</h3>
      {item.tags && <p class="mt-2 font-mono text-xs font-bold tracking-wider text-ketchup uppercase pointer-fine:group-hover:text-ink">{item.tags.join(' · ')}</p>}
    </div>

    <p class="text-sm text-muted transition-colors pointer-fine:group-hover:text-ink/75">
      {item.description && <strong class="block font-bold text-paper transition-colors pointer-fine:group-hover:text-ink">{item.description}</strong>}
      {item.ingredients && `${item.ingredients.join(', ')}.`}
    </p>

    <p class="font-display text-2xl md:text-right">
      {item.price !== undefined ? formatPrice(item.price) : <span class="font-mono text-sm">Pregunta en barra</span>}
    </p>
  </div>
</article>
