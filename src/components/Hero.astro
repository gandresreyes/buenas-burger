---
/**
 * Portada: el rótulo de neón del local como protagonista, a pantalla completa.
 * Al hacer scroll el rótulo se aleja (escala + opacidad) y da paso al despiece
 * de la burger, que es la siguiente sección.
 */
import { site } from '../data/site';
import OpenSign from './OpenSign.astro';
---

<section id="inicio" class="relative flex min-h-svh flex-col items-center justify-center px-4 pt-24 pb-16 text-center sm:px-6">
  <div class="will-change-transform" data-hero-content>
    <OpenSign />

    <!-- Rótulo: cada palabra "se enciende" al cargar y algunas letras parpadean -->
    <h1 class="mt-8 font-neon leading-[0.9] normal-case">
      <span class="power-on block text-7xl neon-pink sm:text-9xl lg:text-[11rem]">
        Bue<span class="flicker">n</span>as
      </span>
      <span class="power-on block text-6xl neon-amber [animation-delay:400ms] sm:text-8xl lg:text-9xl">
        Burgers
      </span>
    </h1>

    <p class="mx-auto mt-8 max-w-md text-lg text-muted">
      Smash burgers de vaca madurada, pan de patata y salsas de la casa. En pleno centro de {site.address.city}.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="/carta"
        class="rounded-full border-2 px-7 py-3 font-display text-lg tracking-wider text-cream uppercase glow-pink transition-transform hover:-translate-y-0.5"
      >
        Ver la carta
      </a>
      <a
        href={site.address.mapsUrl}
        target="_blank"
        rel="noopener"
        class="rounded-full border-2 border-line px-7 py-3 font-display text-lg tracking-wider uppercase transition-colors hover:border-amber hover:text-amber"
      >
        Cómo llegar
      </a>
    </div>
  </div>

  <!-- Indicador de scroll: un tubo de neón con una "gota" de luz bajando -->
  <a
    href="#la-rosa"
    class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-[11px] font-bold tracking-[0.3em] text-muted uppercase hover:text-cream"
    data-hero-cue
  >
    Descubre la Rosa
    <span class="relative h-12 w-px overflow-hidden bg-line" aria-hidden="true">
      <span class="scroll-drop absolute inset-x-0 top-0 h-4 bg-pink shadow-[0_0_8px_var(--color-pink)]"></span>
    </span>
  </a>
</section>

<style>
  /* Gota de luz que recorre el tubo del indicador de scroll */
  .scroll-drop {
    animation: scroll-drop 1.8s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  @keyframes scroll-drop {
    from { transform: translateY(-100%); }
    to   { transform: translateY(300%); }
  }
</style>

<script>
  import { gsap, MOTION_OK } from '../lib/motion';

  gsap.matchMedia().add(MOTION_OK, () => {
    // El rótulo se aleja y se apaga a medida que la portada sale de pantalla
    gsap.to('[data-hero-content]', {
      scale: 0.85,
      autoAlpha: 0,
      ease: 'none',
      scrollTrigger: { trigger: '#inicio', start: 'top top', end: 'bottom top', scrub: true },
    });

    gsap.to('[data-hero-cue]', {
      autoAlpha: 0,
      ease: 'none',
      scrollTrigger: { trigger: '#inicio', start: 'top top', end: '15% top', scrub: true },
    });
  });
</script>
