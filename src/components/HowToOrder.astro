---
/**
 * Sección "Cómo pedir": el local funciona con pedido en barra y avisador,
 * así que lo explicamos para que nadie espere a que le tomen nota en la mesa.
 * Tres pasos con números grandes perfilados y una línea fina encima de cada uno.
 * El pedido a domicilio está en la sección siguiente (Slogan: "Buenas en tu casa…").
 */
const steps = [
  { title: 'Pide en barra', text: 'Elige tu burger y paga directamente en la barra.' },
  { title: 'Coge tu avisador', text: 'Te damos un llamador. Busca mesa y ponte cómodo.' },
  { title: 'Recógela caliente', text: 'Cuando suene, tu burger está lista. Recién salida de la plancha.' },
];
---

<section id="como-pedir" aria-labelledby="como-pedir-title" class="px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <header data-reveal>
      <p class="font-mono text-sm font-bold tracking-widest text-mustard">( Fácil y rápido )</p>
      <h2 id="como-pedir-title" class="mt-4 text-5xl leading-[0.95] sm:text-7xl">Cómo pedir</h2>
      <p class="mt-4 max-w-md text-muted">Aquí no hay camareros ni reservas: lo hacemos rápido para que llegue caliente.</p>
    </header>

    <ol class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        steps.map(({ title, text }, i) => (
          <li class="border-t border-line pt-6" data-reveal>
            <span
              class="block font-display text-8xl leading-none text-transparent [-webkit-text-stroke:1.5px_var(--color-mustard)]"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-6 text-2xl">{title}</h3>
            <p class="mt-2 max-w-xs text-muted">{text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
