---
/**
 * Botones a las plataformas de reparto (Glovo, Just Eat…) con su logo.
 * Los enlaces salen de site.delivery; aquí solo se asocia cada id con su logo.
 */
import { site } from '../data/site';
import GlovoLogo from '../assets/delivery/glovo.svg';
import JustEatLogo from '../assets/delivery/justeat.svg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const logos = { glovo: GlovoLogo, justeat: JustEatLogo };
---

<ul class:list={['flex flex-wrap justify-center gap-4', className]}>
  {
    site.delivery.map(({ id, name, url }) => {
      const Logo = logos[id];
      return (
        <li>
          <a
            href={url}
            target="_blank"
            rel="noopener"
            class="flex h-13 items-center gap-3 rounded-full border border-line bg-ink-soft px-6 font-semibold text-paper transition-colors hover:border-mustard hover:text-mustard"
          >
            <Logo class="size-6" aria-hidden="true" />
            <span>
              Pide en {name}
              <span class="sr-only"> (se abre en otra pestaña)</span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
