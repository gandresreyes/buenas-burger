---
/**
 * Sección "Carta" de la portada: adelanto con una selección de burgers
 * (homePicks en src/data/menu.ts) como lista editorial de filas grandes,
 * y enlace a la carta completa en /carta.
 */
import { homePicks } from '../data/menu';
import MenuRow from './MenuRow.astro';
---

<section id="carta" aria-labelledby="carta-title" class="px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <header class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="font-mono text-sm font-bold tracking-widest text-mustard">( Recién aplastadas )</p>
        <h2 id="carta-title" class="mt-4 text-5xl leading-[0.95] sm:text-7xl">Las que<br />más pedís</h2>
      </div>
      <a href="/carta" class="group font-mono text-sm font-bold tracking-wider uppercase hover:text-mustard">
        Ver la carta completa <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </header>

    <ol class="mt-14 border-t border-line">
      {
        homePicks.map((burger, i) => (
          <li data-reveal>
            <MenuRow item={burger} index={i + 1} />
          </li>
        ))
      }
    </ol>

    <p class="mt-10 text-muted" data-reveal>
      <strong class="text-paper">Todas nuestras burgers se pueden preparar sin gluten.</strong>{' '}
      Si tienes alguna alergia, avísanos en barra al pedir.
    </p>
  </div>
</section>
