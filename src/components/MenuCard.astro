---
/**
 * Tarjeta de un plato de la carta. El borde se enciende en neón al pasar el ratón.
 */
import { formatPrice, type MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;

// Mapas de clases completas por color: Tailwind solo genera clases que ve escritas
const hoverGlow = {
  pink: 'hover:glow-pink focus-within:glow-pink',
  amber: 'hover:glow-amber focus-within:glow-amber',
  cyan: 'hover:glow-cyan focus-within:glow-cyan',
}[item.accent];
const titleNeon = { pink: 'group-hover:neon-pink', amber: 'group-hover:neon-amber', cyan: 'group-hover:neon-cyan' }[
  item.accent
];
---

<article
  class:list={[
    'group relative flex h-full flex-col rounded-2xl border-2 border-line bg-night-soft p-6 transition-shadow duration-300',
    hoverGlow,
  ]}
>
  <h3 class:list={['text-2xl transition-[color,text-shadow]', titleNeon]}>{item.name}</h3>

  {item.tags && <p class="mt-2 text-xs font-bold tracking-widest text-amber uppercase">{item.tags.join(' · ')}</p>}

  {item.description && <p class="mt-4 text-cream">{item.description}</p>}

  <!-- grow empuja el precio al fondo para que todas las tarjetas de una fila lo alineen -->
  <p class:list={['grow text-muted', item.description ? 'mt-2' : 'mt-4']}>
    {item.ingredients && `${item.ingredients.join(', ')}.`}
  </p>

  {
    item.price !== undefined ? (
      <p class="mt-6 font-display text-2xl text-cream">{formatPrice(item.price)}</p>
    ) : (
      <p class="mt-6 text-sm font-bold tracking-widest text-muted uppercase">Pregunta en barra</p>
    )
  }
</article>
