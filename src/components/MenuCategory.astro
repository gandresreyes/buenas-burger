---
/**
 * Una categoría de la carta en /carta, impresa como un ticket de barra:
 * papel con bordes perforados, letra de impresora y puntos hasta el precio.
 * Los platos con ingredientes los listan debajo; las categorías `compact`
 * (bebidas) quedan en una sola línea nombre-precio.
 */
import { formatPrice, type MenuCategory } from '../data/menu';
import SectionHeading from './SectionHeading.astro';

interface Props {
  category: MenuCategory;
  accent?: 'mustard' | 'ketchup' | 'pickle';
}

const { category, accent } = Astro.props;
const titleId = `${category.id}-title`;
---

<section id={category.id} aria-labelledby={titleId} class="px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <SectionHeading id={titleId} eyebrow={category.eyebrow} title={category.title} accent={accent} />

    <div class="bg-paper px-5 py-10 font-mono text-ink ticket-edge sm:px-10" data-reveal>
      {category.note && <p class="mb-6 border-b-2 border-dashed border-ink/30 pb-6 text-center text-sm">{category.note}</p>}

      <ul class:list={[category.compact ? 'space-y-3' : 'space-y-7']}>
        {
          category.items.map((item) => (
            <li>
              <p class="flex items-baseline gap-3">
                <span class="font-display text-lg leading-tight uppercase sm:text-xl">{item.name}</span>
                <span class="dot-leader" aria-hidden="true" />
                <span class="shrink-0 font-bold">
                  {item.price !== undefined ? formatPrice(item.price) : 'Pregunta en barra'}
                </span>
              </p>

              {item.tags && <p class="mt-1 text-xs font-bold text-ketchup uppercase">{item.tags.join(' · ')}</p>}
              {item.description && <p class="mt-1 text-sm font-bold">{item.description}</p>}
              {item.ingredients && <p class="mt-1 text-sm text-faded">{item.ingredients.join(' / ')}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
