---
/**
 * Una categoría de la carta en /carta: tarjetas para platos con ingredientes,
 * o lista compacta nombre-precio cuando la categoría es `compact` (bebidas).
 */
import { formatPrice, type MenuCategory } from '../data/menu';
import MenuCard from './MenuCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  category: MenuCategory;
  accent?: 'pink' | 'amber' | 'cyan';
}

const { category, accent } = Astro.props;
const titleId = `${category.id}-title`;
---

<section id={category.id} aria-labelledby={titleId} class="px-4 py-16 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <SectionHeading id={titleId} eyebrow={category.eyebrow} title={category.title} accent={accent} />

    {category.note && <p class="-mt-6 mb-10 text-center text-muted" data-reveal>{category.note}</p>}

    {
      category.compact ? (
        <ul class="mx-auto max-w-md divide-y divide-line rounded-2xl border-2 border-line bg-night-soft px-6" data-reveal>
          {category.items.map((item) => (
            <li class="flex items-baseline justify-between gap-4 py-4">
              <span class="font-display text-xl tracking-wide uppercase">{item.name}</span>
              {item.price !== undefined && <span class="font-display text-xl">{formatPrice(item.price)}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {category.items.map((item) => (
            <li data-reveal>
              <MenuCard item={item} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
