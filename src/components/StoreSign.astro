---
/**
 * El rótulo de la fachada del local: franja negra con "BUENAS" en mostaza,
 * "BURGERS" en blanco y el icono de la burger a la derecha. Sirve para que se
 * reconozca la entrada al llegar. Es texto real (no imagen), así que se lee
 * como el nombre del local.
 */
import { site } from '../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const [first, ...rest] = site.name.split(' ');
---

<div
  class:list={[
    'flex items-center justify-between gap-4 rounded-lg border-y-4 border-line bg-ink px-5 py-4 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.7)] sm:px-8 sm:py-6',
    className,
  ]}
>
  <p class="font-sans text-[clamp(1.05rem,5.2vw,3.5rem)] leading-none font-black tracking-wide whitespace-nowrap uppercase">
    <span class="text-mustard">{first}</span>{' '}
    <span class="text-paper">{rest.join(' ')}</span>
  </p>

  <!-- Icono de la burger del rótulo: pan con sésamo, carne y base -->
  <svg viewBox="0 0 48 40" class="h-[clamp(1.75rem,7vw,3.75rem)] shrink-0 fill-paper" aria-hidden="true">
    <path d="M4 16C4 7 13 2 24 2s20 5 20 14v1H4Z" />
    <g class="fill-ink">
      <ellipse cx="16" cy="9" rx="1.6" ry="1" /><ellipse cx="24" cy="7" rx="1.6" ry="1" /><ellipse cx="32" cy="9" rx="1.6" ry="1" />
      <ellipse cx="20" cy="13" rx="1.6" ry="1" /><ellipse cx="28" cy="13" rx="1.6" ry="1" />
    </g>
    <rect x="2" y="20" width="44" height="5" rx="2.5" />
    <path d="M4 28h40v3c0 4-4 7-9 7H13c-5 0-9-3-9-7Z" />
  </svg>
</div>
