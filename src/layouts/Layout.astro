---
/**
 * Layout base: <head> con SEO, fuentes y datos estructurados.
 * Todas las páginas lo usan para compartir la misma configuración.
 */
import { Font } from 'astro:assets';
import { site, openingHours } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} · ${site.tagline}`, description = site.description } = Astro.props;

// URL canónica: solo se genera si `site` está definido en astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Imagen al compartir: las redes piden URL absoluta, así que depende de `site`
const ogImage = Astro.site ? new URL('/og-image.jpg', Astro.site).href : '/og-image.jpg';

// Schema.org Restaurant: ayuda a Google a mostrar horario, dirección y teléfono
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: site.description,
  servesCuisine: ['Hamburguesas', 'Smash burgers'],
  telephone: site.contact.phoneHref,
  email: site.contact.email,
  acceptsReservations: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: openingHours.flatMap(({ days, shifts }) =>
    shifts.map(([opens, closes]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: days.map((d) => dayNames[d]),
      opens,
      closes,
    })),
  ),
  ...(Astro.site && { url: Astro.site.href, hasMenu: new URL('/carta', Astro.site).href }),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Color de la barra del navegador en móvil -->
    <meta name="theme-color" content="#0d0c0b" />
    <!-- Favicon: SVG para navegadores modernos, .ico de respaldo e icono para iPhone -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph: vista previa al compartir en WhatsApp, Instagram, etc. -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Smash burger doble con cheddar bajo el cartel de ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fuentes: solo precargamos la de los titulares, que es lo primero que se ve -->
    <Font cssVariable="--font-lilita-one" preload />
    <Font cssVariable="--font-space-mono" />
    <Font cssVariable="--font-anton" />
    <Font cssVariable="--font-gochi-hand" />
    <Font cssVariable="--font-dm-sans" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh">
    <!-- Enlace de salto para usuarios de teclado y lectores de pantalla -->
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-mustard focus:px-4 focus:py-2 focus:text-ink"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
